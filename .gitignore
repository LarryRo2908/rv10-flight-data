# Ignore raw bulk CSV files (retained locally in data/raw_csvs/)
data/raw_csvs/*.csv
*.csv

# Ignore temporary task working directory
temp/*
!temp/.gitkeep

# Python and System caches
__pycache__/
*.pyc
.DS_Store
data/savvy_session.json

# Ignore single telemetry binary files over 100MB (GitHub single-file limit)
data/parquet/n205en_engine_telemetry.parquet
data/parquet/test_combined.parquet
data/parquet/backups/
data/debug/*.parquet


